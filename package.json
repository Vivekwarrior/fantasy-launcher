{
  "name": "fantasy-launcher",
  "productName": "Fantasy Launcher",
  "version": "1.0.0",
  "description": "A lightweight, fantasy-styled Minecraft launcher with Modrinth mod support, Fabric/Quilt/Forge/NeoForge loaders and offline profiles.",
  "main": "main.cjs",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "preview": "node server.cjs",
    "dist": "electron-builder"
  },
  "build": {
